{
  "name": "printcat",
  "productName": "Print Catalog",
  "version": "1.0.0",
  "description": "Print job catalog and management app for the makerspace's Prusa MK4S printers.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mh-acl/PrintCat.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mh-acl/PrintCat/issues"
  },
  "homepage": "https://github.com/mh-acl/PrintCat#readme",
  "dependencies": {
    "chokidar": "^5.0.0",
    "cropperjs": "^1.6.3",
    "pdf-lib": "^1.17.1",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mh-acl.printcatalog",
    "productName": "Print Catalog",
    "files": [
      "src/**/*",
      "package.json",
      "!src/main/bin/**"
    ],
    "extraResources": [
      {
        "from": "src/main/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
